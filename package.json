{
  "name": "findev",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build:wasm",
    "start": "ng serve",
    "prebuild": "npm run build:wasm",
    "build": "ng build",
    "build:wasm": "wasm-pack build wasm/market-gen --target web --release --no-pack --out-dir ../../src/wasm/market-gen",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run build:wasm",
    "test": "ng test",
    "test:wasm": "cargo test --manifest-path wasm/market-gen/Cargo.toml",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:wasm": "cargo fmt --manifest-path wasm/market-gen/Cargo.toml --check && cargo clippy --manifest-path wasm/market-gen/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
